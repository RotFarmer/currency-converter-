<?xml version="1.0" encoding="utf-8"?>
<!-- Converter widget: a keypad that converts between the local and your home currency. Colours are set from the app's theme in Widgets.paintFrame. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <ImageView
        android:id="@+id/widget_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/marker"
                android:layout_width="4dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_solid" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="🇯🇵 JAPAN"
                android:textColor="#CFE3D3"
                android:textSize="11dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pair"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="JPY → USD"
                android:textColor="#7DFF72"
                android:textSize="11dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/widget_refresh"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="3h ⟳"
                android:textColor="#6F8A76"
                android:textSize="10dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="3dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_solid" />

        <LinearLayout
            android:id="@+id/display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:autoSizeMaxTextSize="26dp"
                android:autoSizeMinTextSize="12dp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:text="¥1,280"
                android:textColor="#CFE3D3"
                android:textSize="26dp" />

            <TextView
                android:id="@+id/output"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:autoSizeMaxTextSize="16dp"
                android:autoSizeMinTextSize="10dp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:text="= $8.39"
                android:textColor="#7DFF72"
                android:textSize="16dp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="9"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_back"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="⌫"
                    android:textColor="#7DFF72"
                    android:textSize="18dp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="6"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_clear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="#7DFF72"
                    android:textSize="18dp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_swap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="⇄"
                    android:textColor="#7DFF72"
                    android:textSize="18dp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="2"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_00"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="00"
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
                <TextView
                    android:id="@+id/key_dot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_key_dark"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="."
                    android:textColor="#CFE3D3"
                    android:textSize="18dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
