<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. Colours are set from the app's theme in ConverterWidgetProvider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <ImageView
        android:id="@+id/widget_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/marker"
                android:layout_width="4dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_solid" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="@string/widget_title"
                android:textColor="#CFE3D3"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="→ USD"
                android:textColor="#7DFF72"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/widget_refresh"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="3 hours ago  ⟳"
                android:textColor="#6F8A76"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_solid" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="@string/widget_setup"
            android:textColor="#6F8A76"
            android:textSize="13sp"
            android:visibility="gone" />

            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/row1_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="¥1,000"
                    android:textColor="#CFE3D3"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/row1_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="$6.56"
                    android:textColor="#7DFF72"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/row2_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="€10.00"
                    android:textColor="#CFE3D3"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/row2_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="$10.87"
                    android:textColor="#7DFF72"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/row3_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="£10.00"
                    android:textColor="#CFE3D3"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/row3_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="$12.80"
                    android:textColor="#7DFF72"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/row4_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="฿100"
                    android:textColor="#CFE3D3"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/row4_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="$2.95"
                    android:textColor="#7DFF72"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/row5_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="₩10,000"
                    android:textColor="#CFE3D3"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/row5_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="$7.21"
                    android:textColor="#7DFF72"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/row6_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="CHF 10.00"
                    android:textColor="#CFE3D3"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/row6_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="$11.34"
                    android:textColor="#7DFF72"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

    </LinearLayout>
</FrameLayout>
