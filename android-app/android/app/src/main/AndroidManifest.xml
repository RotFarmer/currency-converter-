        <!-- Home-screen widgets -->
        <receiver
            android:name=".ConverterWidget"
            android:exported="false"
            android:label="@string/converter_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_converter_info" />
        </receiver>

        <receiver
            android:name=".ReferenceWidget"
            android:exported="false"
            android:label="@string/reference_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reference_info" />
        </receiver>

        <receiver
            android:name=".ScanWidget"
            android:exported="false"
            android:label="@string/scan_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_scan_info" />
        </receiver>

        <!-- Taps on the widgets (keypad keys, refresh) -->
        <receiver
            android:name=".WidgetActions"
            android:exported="false" />

        <!-- Travelling: the widgets switch currency when the time zone changes (only the system sends this) -->
        <receiver
            android:name=".TimeZoneReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- App updates: the installer's report, and a check every few hours -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <service
            android:name=".UpdateJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The icon switches to the theme's a minute after you leave the app -->
        <service
            android:name=".IconJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Live camera and photos of price tags -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Optional: set "Price in" from where you are -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Installing its own updates (you confirm the first one; later ones can install without asking) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Keeps the periodic update check after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The update check waits for a connection; Android requires this for jobs with that condition -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
