            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true" />

        <!-- The app's icon in the launcher: one entry per theme, only the current theme's switched on (AppIcon).
             The HUD one keeps the old name, so home-screen icons from before stay put. -->
